{
  "name": "Process Audio Pipeline",
  "description": "Isola vocais (kits.ai), sincroniza, mixa e envia pr\u00e9via via WhatsApp \u2014 polling encadeado sem ciclos.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ProcessingJob",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_audio_pipeline",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "start1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "startKitsIsolation",
            "args": {
              "file_uri": "${ .trigger.data.audio1_file_uri }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "rate_limit_wait",
          "x-base44": {
            "title": "Iniciar \u00c1udio 1",
            "description": "Cria job no kits.ai"
          }
        }
      },
      {
        "rate_limit_wait": {
          "wait": "PT65S",
          "then": "start2",
          "x-base44": {
            "title": "Aguardar rate limit",
            "description": "65s entre envios"
          }
        }
      },
      {
        "start2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "startKitsIsolation",
            "args": {
              "file_uri": "${ .trigger.data.audio2_file_uri }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "initial_wait",
          "x-base44": {
            "title": "Iniciar \u00c1udio 2",
            "description": "Cria job no kits.ai"
          }
        }
      },
      {
        "initial_wait": {
          "wait": "PT30S",
          "then": "check1a",
          "x-base44": {
            "title": "Aguardar processamento",
            "description": "30s para o kits.ai"
          }
        }
      },
      {
        "check1a": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1a_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 1"
          }
        }
      },
      {
        "check1a_sw": {
          "switch": [
            {
              "when": "${ .check1a.done == true }",
              "then": "check2a"
            },
            {
              "when": "${ true }",
              "then": "wait1a"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "wait1a": {
          "wait": "PT15S",
          "then": "check1b",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check1b": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1b_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 2"
          }
        }
      },
      {
        "check1b_sw": {
          "switch": [
            {
              "when": "${ .check1b.done == true }",
              "then": "check2a"
            },
            {
              "when": "${ true }",
              "then": "wait1b"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "wait1b": {
          "wait": "PT15S",
          "then": "check1c",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check1c": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1c_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 3"
          }
        }
      },
      {
        "check1c_sw": {
          "switch": [
            {
              "when": "${ .check1c.done == true }",
              "then": "check2a"
            },
            {
              "when": "${ true }",
              "then": "wait1c"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "wait1c": {
          "wait": "PT15S",
          "then": "check1d",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check1d": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1d_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 4"
          }
        }
      },
      {
        "check1d_sw": {
          "switch": [
            {
              "when": "${ .check1d.done == true }",
              "then": "check2a"
            },
            {
              "when": "${ true }",
              "then": "wait1d"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "wait1d": {
          "wait": "PT15S",
          "then": "check1e",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check1e": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1e_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 5"
          }
        }
      },
      {
        "check1e_sw": {
          "switch": [
            {
