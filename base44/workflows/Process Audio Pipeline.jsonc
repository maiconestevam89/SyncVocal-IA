            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "fail1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "markJobFailed",
            "args": {
              "job_id": "${ .trigger.entity_id }",
              "error_message": "Tempo limite: isolamento do \u00c1udio 1 n\u00e3o concluiu no kits.ai."
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Falhar job",
            "description": "\u00c1udio 1 excedeu limite"
          }
        }
      },
      {
        "check2a": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2a_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 2",
            "description": "Tentativa 1"
          }
        }
      },
      {
        "check2a_sw": {
          "switch": [
            {
              "when": "${ .check2a.done == true }",
              "then": "process"
            },
            {
              "when": "${ true }",
              "then": "wait2a"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 2 pronto?"
          }
        }
      },
      {
        "wait2a": {
          "wait": "PT15S",
          "then": "check2b",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check2b": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2b_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 2",
            "description": "Tentativa 2"
          }
        }
      },
      {
        "check2b_sw": {
          "switch": [
            {
              "when": "${ .check2b.done == true }",
