            }
          ],
          "x-base44": {
            "title": "\u00c1udio 1 pronto?"
          }
        }
      },
      {
        "wait1e": {
          "wait": "PT15S",
          "then": "check1f",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check1f": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start1.kits_job_id }",
              "with_instrumental": true,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check1f_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 1",
            "description": "Tentativa 6"
          }
        }
      },
      {
        "check1f_sw": {
          "switch": [
            {
