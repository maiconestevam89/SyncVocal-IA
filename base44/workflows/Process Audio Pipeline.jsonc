          "then": "check2d",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check2d": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2d_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 2",
            "description": "Tentativa 4"
          }
        }
      },
      {
        "check2d_sw": {
          "switch": [
            {
              "when": "${ .check2d.done == true }",
              "then": "process"
            },
            {
              "when": "${ true }",
              "then": "wait2d"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 2 pronto?"
          }
        }
      },
      {
        "wait2d": {
          "wait": "PT15S",
          "then": "check2e",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check2e": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2e_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 2",
            "description": "Tentativa 5"
          }
        }
      },
      {
        "check2e_sw": {
          "switch": [
            {
              "when": "${ .check2e.done == true }",
              "then": "process"
            },
            {
