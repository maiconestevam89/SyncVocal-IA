            },
            {
              "when": "${ true }",
              "then": "wait2b"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 2 pronto?"
          }
        }
      },
      {
        "wait2b": {
          "wait": "PT15S",
          "then": "check2c",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check2c": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2c_sw",
          "x-base44": {
