              "then": "wait2e"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 2 pronto?"
          }
        }
      },
      {
        "wait2e": {
          "wait": "PT15S",
          "then": "check2f",
          "x-base44": {
            "title": "Aguardar 15s"
          }
        }
      },
      {
        "check2f": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkKitsIsolation",
            "args": {
              "kits_job_id": "${ .start2.kits_job_id }",
              "with_instrumental": false,
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check2f_sw",
          "x-base44": {
            "title": "Verificar \u00c1udio 2",
            "description": "Tentativa 6"
          }
        }
      },
      {
        "check2f_sw": {
          "switch": [
            {
              "when": "${ .check2f.done == true }",
              "then": "process"
            },
            {
              "when": "${ true }",
              "then": "fail2"
            }
          ],
          "x-base44": {
            "title": "\u00c1udio 2 pronto?"
          }
        }
      },
      {
        "fail2": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "markJobFailed",
            "args": {
              "job_id": "${ .trigger.entity_id }",
              "error_message": "Tempo limite: isolamento do \u00c1udio 2 n\u00e3o concluiu no kits.ai."
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Falhar job",
            "description": "\u00c1udio 2 excedeu limite"
          }
        }
      },
      {
        "process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processAndSync",
            "args": {
              "job_id": "${ .trigger.entity_id }",
              "vocal1_uri": "${ .check1a.vocal_uri // .check1b.vocal_uri // .check1c.vocal_uri // .check1d.vocal_uri // .check1e.vocal_uri // .check1f.vocal_uri }",
              "instrumental_uri": "${ .check1a.instrumental_uri // .check1b.instrumental_uri // .check1c.instrumental_uri // .check1d.instrumental_uri // .check1e.instrumental_uri // .check1f.instrumental_uri }",
              "vocal2_uri": "${ .check2a.vocal_uri // .check2b.vocal_uri // .check2c.vocal_uri // .check2d.vocal_uri // .check2e.vocal_uri // .check2f.vocal_uri }"
            }
          },
          "then": "send",
          "x-base44": {
            "title": "Processar e sincronizar",
            "description": "Alinhar + mixar"
          }
        }
      },
      {
        "send": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendUmblerPreview",
            "args": {
              "file_url": "${ .process.preview_url }",
              "audio1_name": "${ .trigger.data.audio1_name }",
              "job_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar pr\u00e9via",
            "description": "WhatsApp do cliente"
          }
        }
