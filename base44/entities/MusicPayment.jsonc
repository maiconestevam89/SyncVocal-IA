{
  "name": "MusicPayment",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Telefone do cliente em formato E.164 ou normalizado"
    },
    "phone_digits": {
      "type": "string",
      "description": "Apenas os dígitos do telefone"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do contato do cliente"
    },
    "asaas_customer_id": {
      "type": "string",
      "description": "Identificador do cliente no Asaas"
    },
    "asaas_payment_id": {
      "type": "string",
      "description": "Identificador da cobrança no Asaas"
    },
    "pix_code": {
      "type": "string",
      "description": "Código Pix Copia e Cola"
    },
    "invoice_url": {
      "type": "string",
      "description": "URL da fatura Asaas"
    },
    "amount": {
      "type": "number",
      "description": "Valor cobrado em reais"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "delivered",
        "failed"
      ],
      "default": "pending",
      "description": "Status da cobrança e entrega dos arquivos"
    },
    "drive_folder_id": {
      "type": "string",
      "description": "ID da pasta principal do cliente no Google Drive"
    },
    "drive_subfolder_name": {
      "type": "string",
      "description": "Nome da subpasta mais recente (ex: MUSICA 01, MUSICA 02)"
    },
    "files_delivered_count": {
      "type": "number",
      "description": "Quantidade de arquivos entregues"
    },
    "error_message": {
      "type": "string",
      "description": "Detalhes de erro caso ocorra falha"
    }
  },
  "required": [
    "phone",
    "status"
  ]
}
